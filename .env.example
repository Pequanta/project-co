# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgres://project_co:project_co@localhost:5432/project_co
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Required. Telegram sends this as `X-Telegram-Bot-Api-Secret-Token` on every
# webhook request; we reject requests that don't carry it.
BOT_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Optional. If set, the bot calls setWebhook(url, secret_token) on startup.
BOT_WEBHOOK_URL=https://your-domain.example/webhook

HTTP_ADDR=0.0.0.0:8080
# Protects the internal API (POST /internal/notifications). Send as `Authorization: Bearer <key>`.
INTERNAL_API_KEY=change-me-internal-api-key

# Deadline reminder window (hours before deadline to warn) and how often the
# background reminder job runs.
DEADLINE_REMINDER_WINDOW_HOURS=72
DEADLINE_REMINDER_INTERVAL_HOURS=6
# Maximum webhook requests from one source IP in a 60-second window.
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

RUST_LOG=info,tower_http=info,sqlx=warn
